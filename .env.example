# Technical proposal, not a confirmed business requirement.
# When "true", starts the MSW worker in the browser during development.
VITE_ENABLE_MSW=true

# Confirmed local server: http://localhost:3000/api/v1. Defaults to "/api/v1"
# (relative, works with MSW). Override only to point at a real backend origin.
VITE_API_BASE_URL=/api/v1
