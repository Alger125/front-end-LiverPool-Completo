# Browser preview with local fixtures. Set to false to use the configured API.
VITE_USE_MOCKS=true

# Opt-in validation controls; hidden in the normal business interface.
VITE_SHOW_DEMO_CONTROLS=false

# Confirmed local server: http://localhost:3000/api/v1. Defaults to "/api/v1"
# (relative, works with MSW). Override only to point at a real backend origin.
VITE_API_BASE_URL=/api/v1
